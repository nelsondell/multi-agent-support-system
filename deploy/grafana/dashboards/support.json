{
  "uid": "support-overview",
  "title": "Support: cost, resolution and vendors",
  "tags": ["support"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": {"from": "now-1h", "to": "now"},
  "panels": [
    {
      "title": "Cost per resolution", "type": "timeseries", "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
      "description": "Model spend over turns answered without a human: escalated turns' spend is carried by the resolved ones.",
      "fieldConfig": {"defaults": {"unit": "currencyUSD"}},
      "targets": [
        {"refId": "A", "expr": "sum(increase(support_model_cost_usd_total[1h])) / clamp_min(sum(increase(support_turns_total{outcome=\"resolved\"}[1h])), 1)", "legendFormat": "USD per resolved turn"}
      ]
    },
    {
      "title": "Resolved without a human, by intent", "type": "timeseries", "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
      "fieldConfig": {"defaults": {"unit": "percentunit"}},
      "targets": [
        {"refId": "A", "expr": "sum by (intent) (rate(support_turns_total{outcome=\"resolved\"}[15m])) / sum by (intent) (rate(support_turns_total[15m]))", "legendFormat": "{{intent}}"}
      ]
    },
    {
      "title": "Escalations by reason", "type": "timeseries", "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8},
      "fieldConfig": {"defaults": {"unit": "short"}},
      "targets": [
        {"refId": "A", "expr": "sum by (reason) (increase(support_escalations_total[5m]))", "legendFormat": "{{reason}}"}
      ]
    },
    {
      "title": "Prompt cache hit rate", "type": "timeseries", "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8},
      "fieldConfig": {"defaults": {"unit": "percentunit"}},
      "targets": [
        {"refId": "A", "expr": "sum(rate(support_model_tokens_total{kind=\"cached\"}[15m])) / clamp_min(sum(rate(support_model_tokens_total{kind=\"input\"}[15m])), 1)", "legendFormat": "cached / input tokens"}
      ]
    },
    {
      "title": "Node latency p50 and p95", "type": "timeseries", "gridPos": {"x": 0, "y": 16, "w": 12, "h": 8},
      "fieldConfig": {"defaults": {"unit": "s"}},
      "targets": [
        {"refId": "A", "expr": "histogram_quantile(0.5, sum by (le, node) (rate(support_node_latency_seconds_bucket[5m])))", "legendFormat": "p50 {{node}}"},
        {"refId": "B", "expr": "histogram_quantile(0.95, sum by (le, node) (rate(support_node_latency_seconds_bucket[5m])))", "legendFormat": "p95 {{node}}"}
      ]
    },
    {
      "title": "Vendor failures after retries", "type": "timeseries", "gridPos": {"x": 12, "y": 16, "w": 12, "h": 8},
      "fieldConfig": {"defaults": {"unit": "short"}},
      "targets": [
        {"refId": "A", "expr": "sum by (vendor, kind) (increase(support_vendor_failures_total[5m]))", "legendFormat": "{{vendor}} {{kind}}"}
      ]
    }
  ]
}
