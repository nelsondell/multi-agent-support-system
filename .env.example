# Copy to .env: `cp .env.example .env`. Read by docker compose and by the app on the host
# (app/settings.py). Only OPENAI_API_KEY has to be filled in; every other value shown is the
# default, except where a comment says otherwise.

# --- Docker --------------------------------------------------------------------------------
# Host port docker compose publishes the API on. Not an app setting: compose reads it from .env.
API_PORT=8000

# --- Model ---------------------------------------------------------------------------------
# Chat model credential. The API refuses to start without it, naming this variable.
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0

# --- Retrieval -----------------------------------------------------------------------------
# Embedder that builds and queries the index: auto (openai when a key is set, else local),
# local (Chroma's bundled model, no key) or openai. Not the default: pinned to local here so the
# first boot needs no key and adding one later cannot silently change the index's embedder.
# Changing it means rebuilding the index; with Docker, `docker compose down -v` drops it.
EMBEDDING_BACKEND=local
# Used only when EMBEDDING_BACKEND resolves to openai.
EMBEDDING_MODEL=text-embedding-3-small
# Chroma directory; chunks.jsonl for BM25 is written next to it. Relative to the working
# directory, which is /app inside the container.
INDEX_PATH=data/processed/chroma
COLLECTION_NAME=getnet_kb
# Chunks handed to generation.
RETRIEVAL_TOP_K=5
# Below this dense similarity the knowledge agent abstains instead of answering. Not calibrated
# yet: re-measure it for whichever embedder is configured.
RETRIEVAL_CONFIDENCE_THRESHOLD=0.35

# --- Routing -------------------------------------------------------------------------------
# Below this self-reported router confidence the request escalates without reaching a specialist.
ROUTER_CONFIDENCE_THRESHOLD=0.6
# Router passes per request; bounds the single hand-back between specialists.
MAX_HOPS=2
