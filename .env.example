# Copy to .env: `cp .env.example .env`. Read by docker compose and by the app on the host
# (app/settings.py). Only OPENAI_API_KEY has to be filled in; every other value shown is the
# default, except where a comment says otherwise.

# --- Docker --------------------------------------------------------------------------------
# Host port docker compose publishes the API on. Not an app setting: compose reads it from .env.
API_PORT=8000

# --- Model ---------------------------------------------------------------------------------
# openai, or fake: deterministic placeholder answers with no key, for the CI smoke test only.
LLM_BACKEND=openai
# Chat model credential. With the openai backend the API refuses to start without it.
OPENAI_API_KEY=
# Chat model, chosen by measurement in evals/router_benchmark.md.
LLM_MODEL=gpt-6-luna
# Reasoning models take an effort (none, low, medium, high or xhigh) and reject a temperature.
# Defaults to low.
# LLM_REASONING_EFFORT=low
# Models without reasoning take a temperature instead: gpt-4o-mini works with LLM_TEMPERATURE=0,
# which leaves the effort unset. Setting both fails at start-up.
# LLM_TEMPERATURE=0
# Model that scores the LLM-as-judge eval (evals/run_judge.py). Never answers a merchant.
JUDGE_MODEL=gpt-6-sol

# --- Retrieval -----------------------------------------------------------------------------
# Embedder that builds and queries the index: openai, local (Chroma's bundled model, no key) or
# auto (openai when a key is set, else local). openai is chosen by measurement in
# evals/retrieval_calibration.md: it separates in-domain from out-of-domain questions and the local
# model does not. CI uses local. Without a key, the first boot stops with this fix and builds
# nothing. Pinned so that adding or removing a key cannot silently change the index's embedder. Changing it means rebuilding the index. With Docker: `docker compose down`, then
# remove only the index volume (`docker volume ls` shows it as <project>_index); conversations
# live elsewhere.
EMBEDDING_BACKEND=openai
# Used only when EMBEDDING_BACKEND resolves to openai.
EMBEDDING_MODEL=text-embedding-3-large
# Chroma directory; chunks.jsonl for BM25 is written next to it. Relative to the working
# directory, which is /app inside the container.
INDEX_PATH=data/processed/chroma
COLLECTION_NAME=getnet_kb
# Chunks handed to generation.
RETRIEVAL_TOP_K=5
# Below this dense similarity the knowledge agent abstains without calling the model. Calibrated
# for text-embedding-3-large in evals/retrieval_calibration.md, so it belongs to that embedder.
# With the local one no value separates the groups: use 0.35 as a floor and let the answer's
# sufficiency flag be the gate.
RETRIEVAL_CONFIDENCE_THRESHOLD=0.52

# --- Web search ----------------------------------------------------------------------------
# Tavily key for general-purpose questions (weather, exchange rates). Without it those questions
# get a pt-BR message saying they cannot be looked up right now; nothing else changes.
TAVILY_API_KEY=
# Pages per search, and seconds before a search is given up as unavailable.
WEB_SEARCH_MAX_RESULTS=3
WEB_SEARCH_TIMEOUT_S=8.0

# --- Memory and storage --------------------------------------------------------------------
# sqlite keeps conversations, cases and per-conversation locks in files on one node; postgres
# keeps them in one database every replica shares (`make scale` sets it for its two replicas).
STORAGE=sqlite
# Postgres connection string, for STORAGE=postgres. It carries a password: never committed.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres
# Connections per replica in each of its two pools (data, and turn locks).
DATABASE_POOL_SIZE=10
# SQLite only. Kept apart from the index on purpose: inside the container this directory is its
# own named volume, so rebuilding the index never deletes a conversation.
STATE_DIR=data/state
# Most recent messages kept verbatim; a merchant turn and its reply count as two.
HISTORY_WINDOW=6
# Once the history would pass this length, everything before the window is folded into a rolling
# summary by one model call. Must be larger than HISTORY_WINDOW.
HISTORY_MAX_MESSAGES=12

# --- Identity ------------------------------------------------------------------------------
# Merchants and operators send a signed JWT (RS256). The identity provider's public keys: an https
# JWKS URL, or the file `make dev-keys` writes (also what docker compose mounts). The API refuses
# to start without them. Mint local tokens with `uv run python scripts/dev_token.py`.
AUTH_JWKS_URL=.dev/jwks.json
AUTH_ISSUER=getnet-support-dev
# Merchant tokens carry this audience and the merchant id in `sub`; operator tokens carry the
# other one and a `role`, operator or supervisor (who may also read the audit log).
MERCHANT_AUDIENCE=support-api
OPERATOR_AUDIENCE=support-operators
# Requests a merchant may make in any 60 seconds, per replica; past it, 429 with Retry-After.
RATE_LIMIT_PER_MINUTE=30
# Conversations idle for longer are erased, with their cases, by `make purge`.
RETENTION_DAYS=90

# --- Operator ------------------------------------------------------------------------------
# Hours a case waits for an operator. After that, the merchant's next message closes it as
# expired and the conversation goes on, so none waits forever.
HANDOFF_TTL_HOURS=24

# --- Tracing -------------------------------------------------------------------------------
# Optional LangSmith tracing of every model call, with inputs and outputs masked before upload.
# Off by default, and forced off when unset, so LangChain never traces anything unmasked on its
# own. On without a key, it stays off.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=getnet-support
# OpenTelemetry spans (GenAI conventions, no content) go to this OTLP gRPC collector when set;
# `make observe` points them at Jaeger.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# --- Cost and caching ----------------------------------------------------------------------
# USD per million tokens of the chat model, for the cost-per-resolution metric. Input and output
# are gpt-6-luna's list prices; the cached-input price is an assumption until the list states it.
LLM_PRICE_INPUT=0.10
LLM_PRICE_CACHED_INPUT=0.01
LLM_PRICE_OUTPUT=0.50
# End each static system prompt at an explicit cache breakpoint (evals/run_cache_benchmark.py).
PROMPT_CACHE=true
# Drills only (scripts/drills/run.sh): model_error, model_timeout, web_down. Never in production.
# FAULT_INJECTION=

# --- Routing -------------------------------------------------------------------------------
# Below this self-reported router confidence the request escalates without reaching a specialist.
ROUTER_CONFIDENCE_THRESHOLD=0.6
# Router passes per request; bounds the single hand-back between specialists.
MAX_HOPS=2
# Steps the supervisor may add to a turn's plan for what a step found; 0 runs the router's plan
# as it is. Model calls and model spend (USD, at LLM_PRICE_*) one turn may reach before it stops
# starting steps and hands the rest to a person as budget_exhausted.
MAX_PLAN_CHANGES=3
MAX_MODEL_CALLS=12
MAX_COST_USD=0.02
# Seconds one attempt of a graph node may take before it is cut, and attempts per node on a model
# failure or a timeout before the turn escalates as model_unavailable. LangGraph enforces both.
NODE_TIMEOUT_S=45
NODE_ATTEMPTS=2
# Seconds one model call may take; a hung vendor fails the call, so its node retries or degrades.
LLM_CALL_TIMEOUT_S=20
